# Copy this file to .env and adjust as needed.

# Port for the dev server and the production Node server.
PORT=3000

# Public name shown in the UI.
APP_NAME=FileVault

# IMPORTANT: set a long random secret in production.
# If omitted, a secret is generated once and stored in data/.jwt-secret.
JWT_SECRET=

# Session lifetime (jsonwebtoken format).
JWT_TTL=7d

# Upload limits.
MAX_UPLOAD_MB=100
MAX_FILES_PER_UPLOAD=10

# Default storage quota for newly created users (MB).
DEFAULT_QUOTA_MB=1024

# Data locations (relative to the project root, or absolute).
DATA_DIR=data
UPLOAD_DIR=uploads

# CORS origin for API calls from browsers ("*" allows any origin).
CORS_ORIGIN=*
